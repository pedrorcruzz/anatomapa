# Modelo de variáveis de ambiente. Copie para .env e preencha com os seus tokens.
# O .env real NUNCA é versionado (está no .gitignore). Este .env.example, sim.
#
# Tokens são só para publicação LOCAL (twine upload). O GitHub Actions NÃO lê o .env:
# no CI a publicação é por Trusted Publishing (OIDC), sem token nenhum.
#
# Gere o token em: https://pypi.org/manage/account/token/
#   Scope "Entire account" no primeiro upload (o projeto ainda não existe).

PYPI_API_TOKEN=pypi-COLE_SEU_TOKEN_DO_PYPI_AQUI

# Opcional, para testar antes em https://test.pypi.org
TESTPYPI_API_TOKEN=pypi-COLE_SEU_TOKEN_DO_TESTPYPI_AQUI
